<!-- =========================================================
     EXCEL DATE + SAVE SCRIPT
========================================================= -->

<script>


/* ============================================================
   EXCEL DATE CONVERTER
============================================================ */




/* ============================================================
   SAVE CLAIMS
============================================================ */

let isSaving = false;


const claimsForm =
    document.getElementById(
        "claimsForm"
    );


const saveButton =
    document.getElementById(
        "saveClaimsBtn"
    );



if (claimsForm) {

    claimsForm.addEventListener(
        "submit",
        function(event) {


            /* ---------------------------------------------
               PREVENT DOUBLE SUBMIT
            --------------------------------------------- */

            if (isSaving) {

                event.preventDefault();

                return false;

            }



            /* ---------------------------------------------
               CONFIRMATION
            --------------------------------------------- */

            const confirmed =
                confirm(
                    "Save all claim changes?"
                );


            if (!confirmed) {

                event.preventDefault();

                return false;

            }



            /* ---------------------------------------------
               MARK SAVING
            --------------------------------------------- */

            isSaving = true;



            /* ---------------------------------------------
               DISABLE SAVE BUTTON
            --------------------------------------------- */

            if (saveButton) {

                saveButton.disabled =
                    true;

                saveButton.innerText =
                    "Saving...";

                saveButton.style.cursor =
                    "not-allowed";

                saveButton.style.opacity =
                    "0.6";

            }



            /* ---------------------------------------------
               DISABLE ALL SUBMIT BUTTONS
            --------------------------------------------- */

            const submitButtons =
                claimsForm.querySelectorAll(
                    'button[type="submit"]'
                );


            submitButtons.forEach(
                function(button) {

                    button.disabled =
                        true;

                }
            );



            /*
             * IMPORTANT:
             *
             * Do NOT use fetch().
             *
             * Let browser submit normally.
             */

            return true;

        }
    );

}

(function () {

    function reloadAt1_40PM() {
        const now = new Date();

        const target = new Date();
        target.setHours(1,40, 0, 0);

        // 12:20 PM already crossed
        if (now >= target) {
            target.setDate(target.getDate() + 1);
        }

        const delay = target.getTime() - now.getTime();

        setTimeout(function () {
            window.location.reload();
        }, delay);
    }

    reloadAt1_40PM();

})();

</script>



<!-- =========================================================
     SUCCESS MESSAGE
========================================================= -->

<% if (
    typeof saved !== "undefined" &&
    saved
) { %>

<script>

window.addEventListener(
    "load",
    function() {

        alert(
