            <th>Platform</th>
            <th>Total Allocated</th>
            <th>Approved</th>
            <th>Rejected</th>
            <th>Query</th>
            <th>Re-Query</th>
            <th>Query + Investigation</th>
            <th>Total Productivity</th>
            <th>Investigation</th>
            <th>Sent-Back</th>
            <th>keep</th>
            <th>other_doctor_executive</th>
            <th>Non Productivity</th>
            <th>Pending</th>
        </tr>

                    </thead>



                   <tbody>

<% if (processSummary &&
       Array.isArray(processSummary.platformSummary)) { %>

    <% processSummary.platformSummary.forEach(row => { %>

        <tr>

            <td><%= row.platform || "-" %></td>

            <td><%= Number(row.total_allocated || 0) %></td>

            <td><%= Number(row.approved || 0) %></td>

            <td><%= Number(row.rejected || 0) %></td>

            <td><%= Number(row.query_count || 0) %></td>

            <td><%= Number(row.requery || 0) %></td>

            <td><%= Number(row.investigation_query || 0) %></td>

