                    Editable fields are highlighted.
                </p>

            </div>


            <!-- LAST SAVED -->

         <%
function formatSavedDate(value) {
    if (!value) return "";

    const date = new Date(value);

    if (isNaN(date.getTime())) {
        return value;
    }

    return date.toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata",
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: true
    });
}
%>

<% if (
    typeof savedAt !== "undefined" &&
    savedAt
) { %>

    <div class="save-time-box">
        <strong>Last Saved:</strong>

        <span>
            <%= formatSavedDate(savedAt) %>
        </span>
    </div>

<% } %>

        </div>



        <!-- =================================================
             SUMMARY CARDS
        ================================================== -->

        


