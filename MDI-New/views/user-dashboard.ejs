            class="logout-btn"
        >
            Logout
        </a>

    </header>



    <!-- =====================================================
         CLAIM SECTION
    ====================================================== -->

    <section class="claims-section">


        <!-- =================================================
             CLAIM TITLE
        ================================================== -->

        <div class="claims-title-row">

            <div>

                <h2>
                    My Assigned Claims
                </h2>

